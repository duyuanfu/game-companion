# 复制为 .env 后修改，.env 不要提交到 Git
# cp .env.docker.example .env
# chmod 600 .env

# 说明：密码请使用大小写字母、数字和 -_ 组合。
# 包含 $ 需要写成 $$，包含 # 或空格需要用引号包住，否则 Compose 会按变量或注释解析。

# ---------- 必填：数据库与缓存 ----------
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=game_companion
MYSQL_USER=game_companion
MYSQL_PASSWORD=replace-with-strong-db-password
REDIS_PASSWORD=replace-with-strong-redis-password

# ---------- Web 对外端口 ----------
# HTTPS 模式下由 web 容器直接终止 TLS，需要放行 80、443
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ---------- 可选：构建加速（服务器访问 Maven / npm 慢时填写） ----------
# MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
# NPM_REGISTRY=https://registry.npmmirror.com
MAVEN_MIRROR_URL=
NPM_REGISTRY=

# ---------- 后端 JVM ----------
JAVA_OPTS="-Xms512m -Xmx1g -XX:+UseG1GC"

# ---------- 域名（必须与 Nginx / 证书一致） ----------
WEB_BASE_URL=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example

# ---------- 支付模式：wechat（真实）/ mock（仅测试，不产生真实资金） ----------
PLATFORM_PAYMENT_MODE=wechat

# ---------- 首次创建管理员，创建成功后请删除这三行并重启 ----------
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=平台管理员

# ---------- 微信支付（不接支付可留空） ----------
WX_PAY_APP_ID=
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_KEY_PATH=/opt/certs/apiclient_key.pem
WX_PAY_CERT_PATH=/opt/certs/apiclient_cert.pem
WX_PAY_NOTIFY_URL=https://your-domain.example/api/pay/notify
WX_PAY_WEB_APP_URL=https://your-domain.example
WX_PAY_TRANSFER_SCENE_ID=
